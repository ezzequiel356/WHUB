# Copiar este archivo a ".env" (en la raíz) y completar con valores reales
# antes de correr "docker compose up". El ".env" real nunca se sube a git.

# Contraseña del usuario root de MySQL (uso administrativo, no la usa la app).
DB_ROOT_PASSWORD=

# Contraseña del usuario restringido que usa el backend (whub_app).
# Este usuario solo puede EJECUTAR los stored procedures, no ver su código
# (ver db/init/02-permisos-app.sh).
DB_APP_PASSWORD=

# Puerto del host donde se expone el frontend. 8080 por defecto (pruebas
# locales, para no chocar con XAMPP u otra cosa que ya use el 80). Para la
# entrega real al cliente, poner 80 (o 443 si hay TLS delante).
FRONTEND_PORT=8080
